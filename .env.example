# Local development uses fictional sample data and local PostgreSQL-compatible storage.
# Production runs on Oracle with a PostgreSQL service and Hermes.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true

# Oracle production. Generate secrets on Oracle; never commit actual values.
# WORKSPACE_MODE=live
# AGENT_BACKEND=hermes
# PORT=8791
# PUBLIC_API_URL=https://oracle.your-tailnet.ts.net:10001
# ALLOWED_ORIGINS=https://oracle.your-tailnet.ts.net:10001
# DATABASE_URL=postgresql://openmuse:password@127.0.0.1:5433/openmuse
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
SESSION_TTL_DAYS=30
# WEB_DIST_DIR=apps/mobile/dist/web
# Optional private AES-256-only HTTPS listener on 127.0.0.1:8792. See docs/PRIVATE-HTTPS.md.
# PRIVATE_HTTPS_PORT=8792
# PRIVATE_HTTPS_CERT_FILE=C:/OpenMuseBusinessOS/secrets/openmuse-tls.crt
# PRIVATE_HTTPS_KEY_FILE=C:/OpenMuseBusinessOS/secrets/openmuse-tls.key

# Interactive chat and durable tasks use the same private Hermes API.
# HERMES_API_URL=http://127.0.0.1:8766
# HERMES_API_KEY=
# HERMES_MODEL=provider-model-id
# HERMES_PROVIDER=provider-id
# HERMES_PROFILE=  # optional capability/profile identity assertion
# ACTION_APPROVAL_MODE=standing-authority
# BUSINESS_API_URL=http://127.0.0.1:8791

# Google OAuth is shared by OpenMuse's Workspace and business connectors.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Callback: PUBLIC_API_URL + /api/google/callback
# SQUARE_ACCESS_TOKEN=  # reuse existing token privately on Oracle
# SQUARE_CLIENT_ID=
# SQUARE_CLIENT_SECRET=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# REVOLUT_CLIENT_ID=
# REVOLUT_PRIVATE_KEY_FILE=C:/OpenMuseBusinessOS/secrets/revolut-private.pem
# Business callbacks: PUBLIC_API_URL + /api/business/oauth/{provider}/callback

# True full-duplex GPT-Live. Key remains on Oracle; clients send WebRTC offers.
# VOICE_OPENAI_API_KEY=
VOICE_NAME=marin
# Apple signing keys remain outside the repository.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=  # must exactly match the signed app bundle identifier
# APNS_PRIVATE_KEY_PATH=C:/OpenMuseBusinessOS/secrets/AuthKey.p8
# Native and web builds: EXPO_PUBLIC_API_URL must be the private HTTPS API URL.

# Optional separate task worker shares PostgreSQL and DATA_DIR.
# Set TASK_WORKER_ENABLED=false on API when running start:worker.
# Only the API process owns voice sessions and the APNs outbox.
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# COMPUTER_DEPLOYMENT_ID=openmuse-business-os
