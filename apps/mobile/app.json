{
  "expo": {
    "name": "OpenMuse",
    "slug": "openmuse",
    "scheme": "openmuse",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.wineandlarder.openmuse",
      "appleTeamId": "K5AYLYH9GW"
    },
    "android": { "package": "au.com.wineandlarder.openmuse" },
    "web": { "bundler": "metro", "name": "OpenMuse — a little room for everything" },
    "plugins": [
      "expo-document-picker",
      "expo-notifications",
      "expo-secure-store",
      "@config-plugins/react-native-webrtc",
      ["./plugins/with-voip-call", { "apnsEnvironment": "development" }],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
